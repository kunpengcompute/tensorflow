+    def concat_op(inputs, meta):
+        return tf.concat(inputs, meta["axis"])
+
+    def build_18input_2D(dtype=np.float32):
+        batch = 150
+        shapes = [
+            (batch, 960),
+            (batch, 24),
+            (batch, 4),
+            (batch, 4),
+            (batch, 4),
+            (batch, 64),
+            (batch, 4),
+            (batch, 4),
+            (batch, 32),
+            (batch, 4),
+            (batch, 4),
+            (batch, 24),
+            (batch, 4),
+            (batch, 4),
+            (batch, 24),
+            (batch, 4),
+            (batch, 4),
+            (batch, 16),
+        ]
+        return [np.random.uniform(0, 1, shape).astype(dtype) for shape in shapes]
+
+    def build_12input_2D(dtype=np.float32):
+        batch = 150
+        shapes = [
+            (batch, 192),
