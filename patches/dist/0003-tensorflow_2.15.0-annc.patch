+                     .Input(FakeInput(indices1_type))  // indices1
+                     .Input(FakeInput(DT_FLOAT))       // params
+                     .Input(FakeInput(indices2_type))  // indices2
+                     .Input(FakeInput(DT_INT32))       // pack_dim
+                     .Input(FakeInput(DT_INT32))       // pack
+                     .Finalize(node_def()));
+    TF_ASSERT_OK(InitOp());
+  }
