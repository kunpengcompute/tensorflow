new file mode 100644
index 0000000000000000000000000000000000000000..5b9215d4c3ed4a004d707061172cfe9a3024cfb6
--- /dev/null
+++ b/Dockerfile.ci
@@ -0,0 +1,59 @@
+FROM openeuler/openeuler:24.03-lts-sp3
+
+ARG TARGETARCH
+ARG HTTP_PROXY=
+ARG HTTPS_PROXY=
+ARG NO_PROXY=localhost,127.0.0.1
+
+ENV HTTP_PROXY=${HTTP_PROXY}
+ENV HTTPS_PROXY=${HTTPS_PROXY}
+ENV http_proxy=${HTTP_PROXY}
+ENV https_proxy=${HTTPS_PROXY}
+ENV NO_PROXY=${NO_PROXY}
+ENV no_proxy=${NO_PROXY}
+
+RUN dnf update -y &&     dnf install -y         gcc-toolset-14-*         java-21-openjdk-devel         wget         unzip         zip         git         git-lfs         which         findutils         python         python3         python3-pip         openssl-devel         snappy-devel         ca-certificates     && dnf clean all
+
+ENV JAVA_HOME=/usr/lib/jvm/java-21-openjdk
+ENV PATH=/opt/openEuler/gcc-toolset-14/root/usr/bin:${PATH}
+ENV LD_LIBRARY_PATH=/opt/openEuler/gcc-toolset-14/root/usr/lib64:${LD_LIBRARY_PATH}
+
+RUN gcc --version && g++ --version && java -version
+
+ARG PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple
+ARG PIP_TRUSTED_HOST=mirrors.aliyun.com
+
+RUN python3 -m pip config set global.index-url ${PIP_INDEX_URL} &&     python3 -m pip config set global.trusted-host ${PIP_TRUSTED_HOST}
+
+RUN python3 -m pip install --no-cache-dir --upgrade setuptools wheel &&     python3 -m pip install --no-cache-dir --prefer-binary         atomgit         protobuf==5.28.3
+
+ARG BAZEL_VERSION=7.4.1
+
+RUN case "${TARGETARCH:-$(uname -m)}" in         amd64|x86_64) bazel_arch=x86_64 ;;         arm64|aarch64) bazel_arch=arm64 ;;         *) echo "Unsupported architecture: ${TARGETARCH:-$(uname -m)}" >&2; exit 1 ;;     esac &&     wget https://mirrors.huaweicloud.com/bazel/${BAZEL_VERSION}/bazel-${BAZEL_VERSION}-linux-${bazel_arch}         -O /usr/local/bin/bazel &&     chmod +x /usr/local/bin/bazel
+
+RUN bazel --version
+
+WORKDIR /workspace/tensorflow
+COPY . .
+
+ARG BAZEL_JOBS=64
+
+RUN mkdir -p /workspace/download
+
+# 构建 TensorFlow wheel 和 predictor_server 测试框架
+RUN bazel         --output_user_root=./output         build         --jobs=${BAZEL_JOBS}         --experimental_repo_remote_exec         --repository_cache=/workspace/repo_cache         --distdir=/workspace/download         --cxxopt=-std=c++17         --host_cxxopt=-std=c++17         --copt=-march=armv8.5-a         --host_copt=-march=armv8.5-a         --linkopt=-Wl,--stub-group-size=0x2000000         --linkopt=-lssl         --linkopt=-lcrypto         --linkopt=-lsnappy         --action_env=http_proxy=http://127.0.0.1:11082         --action_env=https_proxy=http://127.0.0.1:11082         --action_env=no_proxy=localhost,127.0.0.1         --action_env=TF_SYSTEM_LIBS=boringssl,snappy         --define=use_system_libs=openssl         --repo_env=PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/         --repo_env=PIP_TRUSTED_HOST=mirrors.aliyun.com         --check_direct_dependencies=off         -c opt         //tensorflow/tools/pip_package:wheel         //:predictor_server         //:brpc_client
+
+# 复制 wheel 和测试框架二进制到输出目录
+RUN mkdir -p /workspace/dist &&     find ./output -name "tensorflow-*.whl" -exec cp {} /workspace/dist/ \; &&     cp -L bazel-bin/predictor_server bazel-bin/brpc_client /workspace/dist/
+
+# 清除整个 tensorflow 目录（保留 repo_cache 在 /workspace）
+RUN rm -rf /workspace/tensorflow &&     echo "清理完成，repo_cache 已保存在 /workspace/repo_cache"
+
+ENV HTTP_PROXY=
+ENV HTTPS_PROXY=
+ENV http_proxy=
+ENV https_proxy=
+ENV NO_PROXY=
+ENV no_proxy=
+
+WORKDIR /workspace
diff --git a/ci_build.sh b/ci_build.sh
new file mode 100755
index 0000000000000000000000000000000000000000..920edad66cd5b7692e3e89ce49268947b87b6bdb
--- /dev/null
+++ b/ci_build.sh
@@ -0,0 +1,88 @@
+#!/bin/bash
+# TensorFlow CI Build Script for Kunpeng Platform
+
+set -e
+
+TF_DIR="/workspace/tensorflow"
+OUTPUT_BASE="${TF_DIR}/output"
+REPO_CACHE="/workspace/repo_cache"
+DISTDIR="/workspace/download"
+BUILD_LOG="${TF_DIR}/build_$(date +%Y%m%d_%H%M%S).log"
+
+PIP_INDEX_URL="https://mirrors.aliyun.com/pypi/simple/"
+PIP_TRUSTED_HOST="mirrors.aliyun.com"
+NO_PROXY="localhost,127.0.0.1"
+
+# 移除 -O3，使用 bazelrc 中的默认设置
+CXXOPT="-std=c++17"
+COPT="-march=armv8.5-a"
+BAZEL_JOBS="${BAZEL_JOBS:-64}"
+BAZEL_TARGETS=(
+    "//tensorflow/tools/pip_package:wheel"
+    "//:predictor_server"
+    "//:brpc_client"
+)
+
+log_info() { echo -e "\033[32m[INFO]\033[0m $1" | tee -a "${BUILD_LOG}"; }
+log_warn() { echo -e "\033[33m[WARN]\033[0m $1" | tee -a "${BUILD_LOG}"; }
+log_error() { echo -e "\033[31m[ERROR]\033[0m $1" | tee -a "${BUILD_LOG}"; }
+
+log_info "创建构建目录..."
+mkdir -p "${OUTPUT_BASE}" "${REPO_CACHE}" "${DISTDIR}" "${TF_DIR}/dist"
+
+if [ "${CLEAN_CACHE:-false}" = "true" ]; then
+    log_warn "清理旧缓存..."
+    rm -rf "${OUTPUT_BASE:?}/*"
+    log_info "缓存清理完成"
+fi
+
+cd "${TF_DIR}"
+
+log_info "开始构建 TensorFlow wheel 和 predictor_server 测试框架..."
+log_info "构建日志: ${BUILD_LOG}"
+log_info "构建目标: ${BAZEL_TARGETS[*]}"
+
+bazel --output_user_root="${OUTPUT_BASE}" build \
+    --jobs="${BAZEL_JOBS}" \
+    --experimental_repo_remote_exec \
+    --repository_cache="${REPO_CACHE}" \
+    --distdir="${DISTDIR}" \
+    --cxxopt="${CXXOPT}" \
+    --host_cxxopt="${CXXOPT}" \
+    --copt="${COPT}" \
+    --host_copt="${COPT}" \
+    --linkopt=-Wl,--stub-group-size=0x2000000 \
+    --linkopt=-lssl \
+    --linkopt=-lcrypto \
+    --linkopt=-lsnappy \
+    --action_env=http_proxy="${HTTP_PROXY}" \
+    --action_env=https_proxy="${HTTPS_PROXY}" \
+    --action_env=no_proxy="${NO_PROXY}" \
+    --action_env=TF_SYSTEM_LIBS="boringssl,snappy" \
+    --define=use_system_libs=openssl \
+    --repo_env=PIP_INDEX_URL="${PIP_INDEX_URL}" \
+    --repo_env=PIP_TRUSTED_HOST="${PIP_TRUSTED_HOST}" \
+    --check_direct_dependencies=off \
+    -c opt \
+    "${BAZEL_TARGETS[@]}" 2>&1 | tee -a "${BUILD_LOG}"
+
+BUILD_STATUS=${PIPESTATUS[0]}
+
+if [ $BUILD_STATUS -ne 0 ]; then
+    log_error "构建失败，状态码: $BUILD_STATUS"
+    exit 1
+fi
+
+log_info "构建成功！"
+WHEEL_FILE=$(find "${OUTPUT_BASE}" -name "tensorflow-*.whl" -type f 2>/dev/null | head -1)
+if [ -n "${WHEEL_FILE}" ]; then
+    log_info "Wheel 包位置: ${WHEEL_FILE}"
+    cp "${WHEEL_FILE}" "${TF_DIR}/dist/"
+    log_info "已复制到: ${TF_DIR}/dist/"
+fi
+cp -L \
+    "${TF_DIR}/bazel-bin/predictor_server" \
+    "${TF_DIR}/bazel-bin/brpc_client" \
+    "${TF_DIR}/dist/"
+log_info "已保存 predictor_server 和 brpc_client 构建产物"
+ls -lh "${TF_DIR}/dist/"
