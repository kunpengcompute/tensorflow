+TEST_F(KPFusedSparseSegmentReduceNonzeroOpTest, TestIndicesOutOfBounds) {
+  MakeOp(0);
+
+  AddInputFromArray<float>(TensorShape({8}),
+                           {1.0f, 2.0f, 3.0f, 4.0f, 5.0f, 6.0f, 7.0f, 8.0f});
+  AddInputFromArray<int32>(TensorShape({2}), {0, 2});
