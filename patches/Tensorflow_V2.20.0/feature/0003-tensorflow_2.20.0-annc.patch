+                )
+                meta = {
+                    "num_tables": num_tables,
+                    "table_rows": rows,
+                    "embedding_width": embedding_width,
+                    "num_ids": num_ids,
+                    "num_segments": 16,
+                    "reduce_mode": reduce_mode,
+                }
